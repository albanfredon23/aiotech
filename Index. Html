  <!-- SCRIPT DU SIMULATEUR JS -->
  <script>
    const tauRange = document.getElementById('tauRange');
    const tauVal = document.getElementById('tauVal');
    const scenarioSelect = document.getElementById('scenarioSelect');
    const runBtn = document.getElementById('runBtn');
    const simLog = document.getElementById('simLog');
    const simStatus = document.getElementById('simStatus');
    const resSurvival = document.getElementById('resSurvival');
    const resDocs = document.getElementById('resDocs');
    const resSavings = document.getElementById('resSavings');

    tauRange.addEventListener('input', (e) => {
      tauVal.textContent = parseFloat(e.target.value).toFixed(2);
    });

    const scenarios = {
      nominal: {
        title: "Calcul GSM8K Standard",
        branches: [
          { id: 1, s: 0.92, l: 0.88, d: 0.85, valid: true, note: "Décomposition séquentielle stricte" },
          { id: 2, s: 0.78, l: 0.75, d: 0.80, valid: true, note: "Piste alternative valide" },
          { id: 3, s: 0.45, l: 0.30, d: 0.20, valid: false, note: "Saut logique injustifié" },
          { id: 4, s: 0.20, l: 0.15, d: 0.10, valid: false, note: "Contradiction numérique directe" }
        ],
        complexity: 0.52,
        baseDocs: 8,
        allocatedDocs: 3
      },
      adversarial: {
        title: "Prémisse Falsifiée / Multi-documents Contradictoires",
        branches: [
          { id: 1, s: 0.35, l: 0.25, d: 0.15, valid: false, note: "Violation de causalité étape 2" },
          { id: 2, s: 0.40, l: 0.20, d: 0.10, valid: false, note: "Hallucination par association libre" },
          { id: 3, s: 0.30, l: 0.10, d: 0.05, valid: false, note: "Incompatibilité sémantique directe" },
          { id: 4, s: 0.48, l: 0.35, d: 0.20, valid: false, note: "Régression logique" }
        ],
        complexity: 0.88,
        baseDocs: 8,
        allocatedDocs: 2,
        fallbackTriggered: true
      },
      simple: {
        title: "Requête Frugale Immédiate",
        branches: [
          { id: 1, s: 0.98, l: 0.95, d: 0.95, valid: true, note: "Trajectoire directe optimale" },
          { id: 2, s: 0.85, l: 0.80, d: 0.82, valid: true, note: "Redondance valide" },
          { id: 3, s: 0.80, l: 0.78, d: 0.81, valid: true, note: "Variante paraphrasée" },
          { id: 4, s: 0.70, l: 0.65, d: 0.72, valid: true, note: "Explication étendue" }
        ],
        complexity: 0.15,
        baseDocs: 8,
        allocatedDocs: 1
      }
    };

    function executeSimulation() {
      simStatus.textContent = "Calcul de reachability en cours...";
      simStatus.className = "text-cyan-400 animate-pulse";
      simLog.innerHTML = "";

      const scenarioKey = scenarioSelect.value;
      const data = scenarios[scenarioKey];
      const tau = parseFloat(tauRange.value);

      setTimeout(() => {
        let survivors = 0;
        let logsHtml = "";

        data.branches.forEach(b => {
          // Gödel composite score: L * S * D
          const composite = (b.s * b.l * b.d);
          const passed = composite >= (tau * 0.5) && b.valid;
          if (passed) survivors++;

          logsHtml += `
            <div class="p-3 rounded-lg border ${passed ? 'border-emerald-500/30 bg-emerald-500/5' : 'border-red-500/20 bg-red-500/5'} flex items-center justify-between">
              <div>
                <span class="font-bold ${passed ? 'text-emerald-400' : 'text-red-400'}">[Branche ${b.id}]</span> 
                <span class="text-slate-300 ml-2">${b.note}</span>
              </div>
              <div class="text-[11px] font-mono">
                Score: <span class="font-bold ${passed ? 'text-emerald-400' : 'text-red-400'}">${composite.toFixed(3)}</span> 
                (${passed ? 'Admissible' : 'Rejetée'})
              </div>
            </div>
          `;
        });

        if (survivors === 0 && data.fallbackTriggered) {
          logsHtml += `
            <div class="p-2 rounded bg-amber-500/10 border border-amber-500/30 text-amber-400 text-[11px]">
              ⚠️ Alerte ARG : 100 % des branches violent les contraintes logiques. Activation du fallback d'urgence sur la branche la moins dégradée.
            </div>
          `;
        }

        simLog.innerHTML = logsHtml;
        simStatus.textContent = "Inférence terminée";
        simStatus.className = "text-emerald-400";

        resSurvival.textContent = `${survivors} / 4`;
        resDocs.textContent = `${data.allocatedDocs} / ${data.baseDocs} fenêtres`;
        const savingRatio = ((1 - (data.allocatedDocs / data.baseDocs)) * 100).toFixed(0);
        resSavings.textContent = `-${savingRatio} % tokens`;
      }, 350);
    }

    runBtn.addEventListener('click', executeSimulation);
    scenarioSelect.addEventListener('change', executeSimulation);
    executeSimulation();
  </script>
</body>
</html>

# Clés des fournisseurs (lues par LiteLLM) – ne jamais committer le fichier .env
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434

# Routage (identifiants LiteLLM avec préfixe fournisseur)
AIOTECH_FLAGSHIP_MODEL=anthropic/claude-opus-5-5
AIOTECH_CHEAP_MODEL=anthropic/claude-haiku-4-5
AIOTECH_FALLBACK_MODELS=anthropic/claude-sonnet-5-5
AIOTECH_ROUTER_THRESHOLD=0.45

# Tarifs supplémentaires $/Mtok [entrée, sortie] (les tarifs Claude sont inclus)
# AIOTECH_PRICES={"openai/mon-modele": [1.0, 4.0]}

# ARG
AIOTECH_ARG_TAU=0.35
AIOTECH_ARG_MAX_CHUNKS=8
AIOTECH_CONTEXT_TOKEN_BUDGET=2000
AIOTECH_CHUNK_TOKENS=120

# Cache
AIOTECH_CACHE_THRESHOLD=0.85
AIOTECH_CACHE_TTL_SECONDS=86400

# Disjoncteur
AIOTECH_CB_FAILURE_THRESHOLD=3
AIOTECH_CB_RECOVERY_SECONDS=30

# Sécurité / API
AIOTECH_ADMIN_TOKEN=change-moi-par-une-longue-valeur-aleatoire
AIOTECH_REQUIRE_API_KEY=true
AIOTECH_ENABLE_TOOLS=false
# Ignorés sous Docker (docker-compose.yml impose /data et /app/sandbox)
AIOTECH_TOOLS_DIR=./sandbox
AIOTECH_DB_PATH=./aiotech.sqlite3

# 1 = forcer le LLM factice (tests, démonstrations sans clé)
AIOTECH_OFFLINE=0
